{
  "name": "file-portal",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build:packages": "pnpm --filter './packages/**' build",
    "dev": "docker compose up --build",
    "dev:up": "docker compose up -d --build --wait",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f api web",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @portal/api test",
    "test:security": "bash scripts/test-security.sh",
    "db:migrate": "pnpm --filter @portal/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @portal/api db:migrate:deploy",
    "db:seed": "pnpm --filter @portal/api db:seed",
    "db:generate": "pnpm --filter @portal/api db:generate",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
