{
  "name": "@portal/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:container": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env src/scripts/bootstrap-admin.ts",
    "bootstrap:admin": "node dist/scripts/bootstrap-admin.js",
    "bootstrap:admin:dev": "tsx --env-file=../../.env.production src/scripts/bootstrap-admin.ts",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@portal/config": "workspace:*",
    "@portal/types": "workspace:*",
    "@portal/validation": "workspace:*",
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.6.0",
    "prisma": "^6.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
