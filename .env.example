NODE_ENV=development

PORT=4000

DATABASE_URL=mysql://portal:portal@localhost:3306/file_portal

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated list of allowed S3 buckets (set real names only in local .env)
S3_ALLOWED_BUCKETS=your-bucket-name

S3_PRESIGNED_URL_EXPIRATION=300

SESSION_EXPIRATION_HOURS=24

COOKIE_SECURE=false
COOKIE_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
CURSOR_SECRET=change-me-to-another-long-random-secret-32-chars

CORS_ORIGIN=http://localhost:5173
PUBLIC_ORIGIN=http://localhost:5173
TRUST_PROXY=
FORCE_HTTPS=false
ENABLE_API_DOCS=true
GLOBAL_RATE_LIMIT_MAX=300
BODY_LIMIT_BYTES=131072

# The one-time bootstrap creates only this administrator and never resets it.
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeThisAdminPassword1

# Docker development stack host bindings. Keep loopback when host Nginx proxies it.
DEV_BIND_ADDRESS=127.0.0.1
API_PORT=4000
WEB_PORT=5173
# Add the hostname used by the existing development Nginx proxy.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional MySQL container credentials.
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_PASSWORD=local-portal-password
