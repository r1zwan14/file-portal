NODE_ENV=production
PORT=4000

# Prisma resolves sslcert relative to apps/api/prisma.
DATABASE_URL=mysql://portal:strong-password@db.example.com:3306/file_portal?sslcert=/run/secrets/db-ca.pem&sslaccept=strict

AWS_REGION=us-east-1
# Prefer an IAM role. Set both only when role-based credentials are unavailable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ALLOWED_BUCKETS=your-bucket-name
S3_PRESIGNED_URL_EXPIRATION=300

SESSION_EXPIRATION_HOURS=24
COOKIE_SECURE=true
COOKIE_SECRET=replace-with-at-least-48-cryptographically-random-characters
CURSOR_SECRET=replace-with-a-different-48-character-random-secret

PUBLIC_ORIGIN=https://files.example.com
CORS_ORIGIN=https://files.example.com
# The fixed Nginx container address from docker-compose.prod.yml.
TRUST_PROXY=172.30.0.3/32
FORCE_HTTPS=true
ENABLE_API_DOCS=false
GLOBAL_RATE_LIMIT_MAX=300
BODY_LIMIT_BYTES=131072

# Used only by the explicit, one-time bootstrap command.
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Keep the web port loopback-only when the TLS proxy runs on this host.
WEB_BIND_ADDRESS=127.0.0.1
